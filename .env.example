# ==========================================
# SkillIntel - Production & Deployment Env
# ==========================================

# 1. Database Configuration
# Use AWS RDS PostgreSQL or Neon/Supabase PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://username:password@your-rds-endpoint.amazonaws.com:5432/skillintel

# 2. Application Secrets
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
DEMO_LOGIN_PASSWORD=demopassword

# 3. AI Providers
GROQ_API_KEY=gsk_your_groq_api_key_here

# 4. Frontend & CORS Configuration
# Leave blank when using Nginx reverse proxy (same domain), or set to your API domain/IP:
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=demopassword
CORS_ORIGINS=*

# 5. Startup & Automation
AUTO_SEED=true
WEB_CONCURRENCY=2
